{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "PORT=3000 BASE_PATH=/ pnpm install && PORT=3000 BASE_PATH=/ pnpm --filter @workspace/ea-solicitors build",
  "outputDirectory": "artifacts/ea-solicitors/dist/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://website-builder-agenticalchemy.replit.app/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}

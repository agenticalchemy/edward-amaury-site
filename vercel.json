{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "PORT=3000 BASE_PATH=/ pnpm install && PORT=3000 BASE_PATH=/ pnpm --filter @workspace/ea-solicitors build",
  "outputDirectory": "artifacts/ea-solicitors/dist/public",
  "framework": null,
  "functions": {
    "api/[...path].ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
